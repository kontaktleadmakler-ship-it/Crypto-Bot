# Konfiguration für den Signal-Bot
SYMBOL=RENDER-USDT
POLL_INTERVAL_MS=5000
MAX_HISTORY_SIZE=500
REQUEST_TIMEOUT_MS=10000
LOCK_STALE_AFTER_MS=30000
LOCK_HEARTBEAT_INTERVAL_MS=5000

# 2026-09-02 signal/event-loop hardening
SCAN_CONCURRENCY=2
MARKET_DATA_CONCURRENCY=3
FUTURES_API_CONCURRENCY=8
FUTURES_API_QUEUE_TIMEOUT_MS=5000
# Optional: allow a recent 15m snapshot to keep a symbol evaluable during transient API failures
# The runtime fallback window is 5 minutes.
